# ============================================================
#  AutoMecaStore - Configuration environnement (Backend Django)
#  Copiez ce fichier en ".env" et remplissez vos identifiants.
# ============================================================

# --- Email (SMTP) ---
# Pour Gmail : utilisez un "mot de passe d'application" (compte Google avec 2FA active).
# Une fois EMAIL_HOST_USER rempli, Django bascule automatiquement en SMTP.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AutoMecaStore <noreply@automecastore.sn>

# --- URL publique du site (utilisée dans les emails) ---
SITE_URL=http://127.0.0.1:8000

# --- Clé secrète Django (changez-la en production) ---
SECRET_KEY=change-me-in-production
DEBUG=True

# --- Hôtes autorisés (séparés par des virgules) ---
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# --- CORS : origines autorisées (séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Throttling (limites de débit) ---
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=3/min
THROTTLE_PAYMENT=10/min
THROTTLE_ORDER=10/min

# --- Sécurité production ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
